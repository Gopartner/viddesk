{
  "manifest_version": 3,
  "name": "Video Devtools Window",
  "version": "2.1.0",
  "description": "Jendela mengambang Windows 11: geser, ubah ukuran, ingat posisi, dan unduh video yang sedang diputar.",
  "author": "yudibilly",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Buka/tutup jendela VIDGET",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
