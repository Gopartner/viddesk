{
  "manifest_version": 3,
  "name": "VidDesk - Video Finder, Downloader & Recorder",
  "short_name": "VidDesk",
  "version": "2.2.0",
  "description": "Jendela mengambang Windows 11 untuk mencari, mengunduh, dan merekam video di halaman web.",
  "author": "yudibilly",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Buka/tutup jendela VidDesk",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
